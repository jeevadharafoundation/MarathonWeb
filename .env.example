# Supabase Configuration (Get from Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Cloudflare R2 Media Storage
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
R2_BUCKET_NAME="marathon-payment-details"
R2_PUBLIC_DOMAIN="https://pub-your-id.r2.dev"

# Resend Transactional Email API (Get from resend.com/api-keys)
RESEND_API_KEY="re_your_api_key"
SENDER_EMAIL="onboarding@resend.dev"
ORGANIZER_EMAIL="your-email@domain.com"
